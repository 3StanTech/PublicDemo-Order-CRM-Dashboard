{
  "name": "public-demo-order-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src test e2e scripts tests",
    "test": "vitest run --exclude \"tests/rules/**\"",
    "test:watch": "vitest --exclude \"tests/rules/**\"",
    "test:e2e": "playwright test --project=chromium",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cafe-oms-rules \"vitest run -c vitest.rules.config.ts\"",
    "build:functions": "npm --prefix functions run build",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:public-safe": "node scripts/check-public-safe.mjs",
    "check": "npm run lint && npm test && npm run build && npm run build:functions && npm run check:bundle && npm run check:public-safe && npm run test:rules && npm run test:e2e"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.33.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
